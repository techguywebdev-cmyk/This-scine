{
  "expo": {
    "name": "Thiscene",
    "slug": "thiscene",
    "scheme": "thiscene",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#06060B",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#06060B"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.thiscene.app"
    },
    "android": {
      "package": "com.thiscene.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#06060B",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "@clerk/expo",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FFFFFF"
        }
      ],
      "expo-font",
      "expo-splash-screen",
      "./plugins/withReleaseSigning",
      [
        "expo-audio",
        {
          "microphonePermission": "Thiscene uses your microphone for voice notes and calls.",
          "recordAudioAndroid": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": "https://this-scine.vercel.app"
    }
  }
}