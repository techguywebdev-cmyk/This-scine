{
  "expo": {
    "name": "Thiscene",
    "slug": "thiscene",
    "scheme": "thiscene",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#06060B",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#06060B"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.thiscene.app"
    },
    "android": {
      "package": "com.thiscene.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#06060B",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "@clerk/expo",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FFFFFF"
        }
      ],
      "expo-font",
      "expo-splash-screen",
      "./plugins/withReleaseSigning",
      [
        "expo-audio",
        {
          "microphonePermission": "Thiscene uses your microphone for voice notes and calls.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Thiscene uses your photos so you can post them to your status.",
          "cameraPermission": "Thiscene uses your camera for video calls and status photos.",
          "microphonePermission": "Thiscene uses your microphone for voice notes and calls."
        }
      ],
      "expo-video",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Thiscene uses your camera for video calls.",
          "microphonePermission": "Thiscene uses your microphone for calls and voice notes."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Thiscene uses the microphone when you speak to Ask Thiscene, record voice notes, or make calls.",
          "speechRecognitionPermission": "Thiscene turns what you say into text so it can find something to watch.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": "https://this-scine.vercel.app",
      "eas": {
        "projectId": "7a4680a6-b763-46c5-be33-da36f36e3062"
      }
    },
    "owner": "techguywebdev"
  }
}